{
  "name": "magnafic-course-studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "seed:demo": "sanity documents create demo-content.json --replace",
    "seed:test": "node scripts/prepare-test-content.mjs && sanity documents create demo-content.json --replace",
    "verify:test": "node --env-file=.env scripts/verify-test-content.mjs",
    "inspect:materials": "node --env-file=.env scripts/inspect-material-lessons.mjs",
    "start": "sanity start"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sanity": "^6.6.0",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.14",
    "eslint": "^9.28",
    "prettier": "^3.5",
    "typescript": "^5.8"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
}
