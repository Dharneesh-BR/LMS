NODE_ENV=development
FRONTEND_URL=https://learn.magnafic.ai
FRONTEND_URLS=https://learn.magnafic.ai,https://your-netlify-site.netlify.app,http://localhost:3000,http://localhost:5173
CERTIFICATE_PUBLIC_URL=https://learn.magnafic.ai

FIREBASE_PROJECT_ID=learning-management-syst-adcba
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
ADMIN_EMAIL=admin@magnafic.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_DEPARTMENT=Admin
ADMIN_DESIGNATION=Admin

SANITY_PROJECT_ID=kdugdssj
SANITY_DATASET=production
SANITY_API_VERSION=2024-06-01
SANITY_READ_TOKEN=
# Server-only editor token for mirroring processing status into Sanity Studio.
SANITY_WRITE_TOKEN=
# Generate a random secret of at least 32 characters; set the same secret on the Sanity webhook.
SANITY_KNOWLEDGE_WEBHOOK_SECRET=

# Sprint 3: server-only OpenRouter credentials. Keep disabled until documents are ready.
COURSE_CHAT_ENABLED=false
OPENROUTER_API_KEY=
# Exact model ID supporting strict structured outputs; no automatic model selection.
OPENROUTER_MODEL=openai/gpt-4o
COURSE_CHAT_USER_DAILY_LIMIT=20
COURSE_CHAT_GLOBAL_DAILY_LIMIT=100
COURSE_CHAT_DAILY_TOKEN_BUDGET=200000
COURSE_CHAT_MAX_OUTPUT_TOKENS=600

VIMEO_ACCESS_TOKEN=
VIMEO_ALLOWED_DOMAIN=localhost
