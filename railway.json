{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci && npx prisma generate"
  },
  "deploy": {
    "preDeployCommand": [
      "npx prisma migrate deploy"
    ],
    "startCommand": "npm start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120
  }
}
